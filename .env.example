# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your Supabase project details.
#
# If BOTH variables are left empty, the app runs in LOCAL DEMO MODE and stores
# everything in the browser's localStorage. A banner clearly indicates this.
# -----------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Supabase PUBLISHABLE (anon) key. This key is safe to expose in a frontend.
# NEVER put the service-role key here — it must never reach the browser.
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Deployment base path for GitHub Pages.
#
# On GitHub Actions this is derived automatically from GITHUB_REPOSITORY, so you
# usually do NOT need to set it. Override it here only for custom setups, e.g.
# a custom domain (use "/") or a differently named repository.
#   Example for repo "my-user/quiz":  VITE_BASE_PATH=/quiz/
# -----------------------------------------------------------------------------
VITE_BASE_PATH=
